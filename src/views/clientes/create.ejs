<div class="dashboard-header">
  <div>
    <h1>Novo Cliente</h1>
    <p style="color: var(--on-surface-variant); font-size: 0.875rem;">Preencha as informações abaixo</p>
  </div>
  <div class="dashboard-actions">
    <a href="/clientes" class="btn btn-secondary"><i data-feather="arrow-left"></i> Voltar</a>
  </div>
</div>

<div class="card">
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <form action="/clientes" method="POST">
    <div class="grid grid-cols-2 gap-4">
      <div class="form-group">
        <label for="nome">Nome Completo *</label>
        <input type="text" id="nome" name="nome" class="form-control" required>
      </div>
      <div class="form-group">
        <label for="cpf">CPF *</label>
        <input type="text" id="cpf" name="cpf" class="form-control" required>
      </div>
      <div class="form-group">
        <label for="telefone">Telefone *</label>
        <input type="text" id="telefone" name="telefone" class="form-control" required>
      </div>
      <div class="form-group">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" class="form-control">
      </div>
      <div class="form-group" style="grid-column: span 2;">
        <label for="endereco">Endereço</label>
        <input type="text" id="endereco" name="endereco" class="form-control">
      </div>
    </div>
    <div class="mt-4">
      <button type="submit" class="btn btn-primary"><i data-feather="save"></i> Salvar</button>
    </div>
  </form>
</div>
