<div class="dashboard-header">
  <div>
    <h1>Painel da Oficina</h1>
    <p>Visão geral operacional e financeira em tempo real</p>
  </div>
  <div class="dashboard-actions">
    <button class="btn btn-secondary">
      <i data-feather="download"></i> Exportar Relatório
    </button>
    <a href="/ordens-servico/nova" class="btn btn-primary">
      <i data-feather="plus-circle"></i> Criar Nova O.S.
    </a>
  </div>
</div>

<div class="dashboard-cards">
  <div class="stat-card">
    <div class="stat-card-header">
      <h3>Faturamento do Mês</h3>
      <div class="stat-icon"><i data-feather="dollar-sign"></i></div>
    </div>
    <div class="value">
      R$ <%= parseFloat(stats.faturamentoMes || 0).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
      <span class="stat-trend">+12.4%</span>
    </div>
    <div class="stat-footer">
      <span>vs. mês anterior (R$ 43.370)</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-header">
      <h3>Ordens de Serviço Ativas</h3>
      <div class="stat-icon"><i data-feather="tool"></i></div>
    </div>
    <div class="value">
      <%= stats.abertas + stats.emAndamento %>
      <span style="font-size: 0.75rem; color: var(--on-surface-variant); font-family: var(--font-body); font-weight: 500;">veículos em processo</span>
    </div>
    <div class="stat-footer">
      <span>Concluídas hoje: <strong><%= stats.concluidas %></strong></span>
      <a href="/ordens-servico" style="color: var(--secondary); text-decoration: none; font-weight: 600;">Ver todas <i data-feather="arrow-right" style="width: 12px; height: 12px; vertical-align: middle;"></i></a>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-header">
      <h3>Ocupação de Boxes</h3>
      <div class="stat-icon"><i data-feather="grid"></i></div>
    </div>
    <div class="value">
      12 <span style="font-size: 1rem; color: var(--on-surface-variant);">/16 boxes</span>
      <span style="font-size: 0.75rem; color: var(--secondary); font-family: var(--font-body); font-weight: 700; margin-left: auto;">75% cap.</span>
    </div>
    <div style="width: 100%; height: 4px; background: var(--surface-container); border-radius: 2px; margin-top: 0.5rem; overflow: hidden;">
      <div style="width: 75%; height: 100%; background: var(--secondary);"></div>
    </div>
    <div class="stat-footer">
      <span>Livres: <strong>4 vagas</strong></span>
      <span>Rampas: <strong>100% cheias</strong></span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-header">
      <h3>Ticket Médio por O.S.</h3>
      <div class="stat-icon"><i data-feather="file-text"></i></div>
    </div>
    <div class="value">
      R$ 1.840,00
      <span class="stat-trend" style="background: transparent; color: var(--success);">+3.1%</span>
    </div>
    <div class="stat-footer">
      <span>Tempo médio box: <strong>2.1 dias</strong></span>
      <i data-feather="clock" style="width: 14px; height: 14px;"></i>
    </div>
  </div>
</div>

<div class="grid grid-cols-3 gap-4" style="margin-bottom: 1.5rem;">
  <div class="card" style="grid-column: span 2;">
    <h2 style="font-size: 1.125rem; margin-bottom: 1.5rem;">Faturamento (Últimos 6 Meses)</h2>
    <canvas id="faturamentoChart" height="80"></canvas>
  </div>
  
  <div class="card">
    <h2 style="font-size: 1.125rem; margin-bottom: 1.5rem;">Status das O.S.</h2>
    <div style="height: 200px; display: flex; justify-content: center;">
      <canvas id="statusChart"></canvas>
    </div>
  </div>
</div>

<div class="grid grid-cols-4 gap-4">
  <div class="card" style="padding: 0; grid-column: span 3;">
  <div style="padding: 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
      <h2 style="margin-bottom: 0.25rem; font-size: 1.25rem;">Ordens de Serviço Recentes</h2>
      <p style="margin: 0; font-size: 0.875rem; color: var(--on-surface-variant);">Monitore o fluxo de trabalho e status dos veículos em oficina</p>
    </div>
    <div class="dashboard-actions">
      <div class="search-bar" style="width: 250px; background: var(--surface); border: 1px solid var(--border-color);">
        <i data-feather="search"></i>
        <input type="text" placeholder="Filtrar por placa ou cliente...">
      </div>
      <button class="btn btn-secondary" style="padding: 0.375rem 0.75rem;"><i data-feather="refresh-cw"></i></button>
    </div>
  </div>

  <div style="padding: 1.5rem 1.5rem 0;">
    <div class="tabs">
      <button class="tab active">Todas (<%= ultimasOS ? ultimasOS.length : 0 %>)</button>
      <button class="tab">Em Diagnóstico</button>
      <button class="tab">Aguardando Peças</button>
      <button class="tab">Em Execução</button>
      <button class="tab">Aguardando Retirada</button>
    </div>
  </div>

  <% if (ultimasOS && ultimasOS.length > 0) { %>
    <div class="table-responsive" style="box-shadow: none; border-radius: 0; border: none; border-top: 1px solid var(--border-color); margin-bottom: 0;">
      <table>
        <thead>
          <tr>
            <th>N° O.S.</th>
            <th>CLIENTE & CONTATO</th>
            <th>VEÍCULO & PLACA</th>
            <th>SERVIÇO & MECÂNICO</th>
            <th>STATUS</th>
            <th>AÇÕES</th>
          </tr>
        </thead>
        <tbody>
          <% ultimasOS.forEach(os => { %>
            <tr>
              <td>
                <div style="display: flex; flex-direction: column;">
                  <span style="font-family: var(--font-heading); font-weight: 700; color: var(--secondary);">#<%= os.id.toString().padStart(4, '0') %></span>
                  <span style="font-size: 0.65rem; color: var(--on-surface-variant);">Hoje às 08:30</span>
                </div>
              </td>
              <td>
                <div style="display: flex; flex-direction: column;">
                  <strong><%= os.veiculo.cliente.nome %></strong>
                  <span style="font-size: 0.75rem; color: var(--on-surface-variant);">11 9999-9999</span>
                </div>
              </td>
              <td>
                <div style="display: flex; flex-direction: column;">
                  <strong><%= os.veiculo.marca %> <%= os.veiculo.modelo %></strong>
                  <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem;">
                    <span class="badge badge-light" style="font-family: var(--font-heading); letter-spacing: 0.05em;"><%= os.veiculo.placa %></span>
                    <span style="font-size: 0.65rem; color: var(--on-surface-variant);">45.200 km</span>
                  </div>
                </div>
              </td>
              <td>
                <div style="display: flex; flex-direction: column;">
                  <span style="font-size: 0.875rem;">Revisão Padrão</span>
                  <span style="font-size: 0.75rem; color: var(--on-surface-variant);">Mecânico: <strong>Carlos</strong> (Box 01)</span>
                </div>
              </td>
              <td>
                <% if (os.status === 'aberta') { %>
                  <span class="badge badge-warning-subtle"><span class="status-dot" style="background: var(--warning); margin-right: 0.25rem;"></span> Em Diagnóstico</span>
                <% } else if (os.status === 'em_andamento') { %>
                  <span class="badge badge-secondary"><span class="status-dot" style="background: var(--secondary); margin-right: 0.25rem;"></span> Em Execução</span>
                <% } else if (os.status === 'concluida') { %>
                  <span class="badge badge-success"><span class="status-dot" style="background: var(--success); margin-right: 0.25rem;"></span> Pronto p/ Entrega</span>
                <% } else { %>
                  <span class="badge"><%= os.status %></span>
                <% } %>
              </td>
              <td>
                <div style="display: flex; gap: 0.5rem;">
                  <a href="/ordens-servico/<%= os.id %>" class="btn btn-secondary" style="padding: 0.375rem;"><i data-feather="eye"></i></a>
                  <button class="btn btn-secondary" style="padding: 0.375rem;"><i data-feather="printer"></i></button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    
    <div style="padding: 1rem 1.5rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; font-size: 0.875rem; color: var(--on-surface-variant);">
      <span>Mostrando <strong>1</strong> a <strong><%= ultimasOS.length %></strong> de <strong><%= ultimasOS.length %></strong> ordens de serviço</span>
      <div style="display: flex; gap: 0.25rem;">
        <button class="btn btn-secondary" style="padding: 0.25rem 0.5rem;" disabled>Anterior</button>
        <button class="btn btn-primary" style="padding: 0.25rem 0.5rem;">1</button>
        <button class="btn btn-secondary" style="padding: 0.25rem 0.5rem;">Próxima</button>
      </div>
    </div>
  <% } %>
</div>

  <div class="card" style="padding: 0;">
    <div style="padding: 1.5rem; border-bottom: 1px solid var(--border-color);">
      <h2 style="font-size: 1rem; margin-bottom: 0;">Alertas de Estoque Crítico</h2>
    </div>
    <div style="padding: 1rem;">
      <% if (alertasEstoque && alertasEstoque.length > 0) { %>
        <ul style="list-style: none; margin: 0; padding: 0;">
          <% alertasEstoque.forEach(alerta => { %>
            <li style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0; border-bottom: 1px solid var(--surface-container-low);">
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 32px; height: 32px; background: var(--error-bg); color: var(--error); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                  <i data-feather="alert-triangle" style="width: 16px; height: 16px;"></i>
                </div>
                <div>
                  <strong style="display: block; font-size: 0.875rem;"><%= alerta.nome %></strong>
                  <span style="font-size: 0.75rem; color: var(--on-surface-variant);">Ref: #<%= String(alerta.id).padStart(4, '0') %></span>
                </div>
              </div>
              <span class="badge badge-error"><%= alerta.estoque %> un.</span>
            </li>
          <% }) %>
        </ul>
        <div style="margin-top: 1rem; text-align: center;">
          <a href="/pecas" style="font-size: 0.75rem; font-weight: 600; color: var(--secondary); text-decoration: none;">Ver Estoque Completo</a>
        </div>
      <% } else { %>
        <div style="text-align: center; padding: 2rem 0; color: var(--success);">
          <i data-feather="check-circle" style="width: 32px; height: 32px; margin-bottom: 0.5rem;"></i>
          <p style="font-size: 0.875rem; margin: 0;">Estoque Saudável</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Faturamento Chart
    const faturamentoCtx = document.getElementById('faturamentoChart').getContext('2d');
    new Chart(faturamentoCtx, {
      type: 'bar',
      data: {
        labels: <%- graficos.meses %>,
        datasets: [{
          label: 'Faturamento (R$)',
          data: <%- graficos.faturamento %>,
          backgroundColor: '#0ea5e9',
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
          x: { grid: { display: false } }
        }
      }
    });

    // Status Chart
    const statusCtx = document.getElementById('statusChart').getContext('2d');
    new Chart(statusCtx, {
      type: 'doughnut',
      data: {
        labels: ['Abertas', 'Em Andamento', 'Concluídas'],
        datasets: [{
          data: [<%= stats.abertas %>, <%= stats.emAndamento %>, <%= stats.concluidas %>],
          backgroundColor: ['#f97316', '#0ea5e9', '#166534'],
          borderWidth: 0,
          cutout: '75%'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } }
        }
      }
    });
  });
</script>
