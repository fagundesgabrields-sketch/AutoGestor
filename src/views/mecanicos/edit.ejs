<div class="dashboard-header">
  <div>
    <h1>Editar Mecânico</h1>
    <p style="color: var(--on-surface-variant); font-size: 0.875rem;">Preencha as informações abaixo</p>
  </div>
  <div class="dashboard-actions">
    <a href="/mecanicos" class="btn btn-secondary"><i data-feather="arrow-left"></i> Voltar</a>
  </div>
</div>

<div class="card">
  <form action="/mecanicos/<%= mecanico.id %>?_method=PUT" method="POST">
    <div class="grid grid-cols-2 gap-4">
      <div class="form-group" style="grid-column: span 2;">
        <label for="nome">Nome *</label>
        <input type="text" id="nome" name="nome" class="form-control" value="<%= mecanico.nome %>" required>
      </div>
      <div class="form-group">
        <label for="especialidade">Especialidade</label>
        <input type="text" id="especialidade" name="especialidade" class="form-control" value="<%= mecanico.especialidade %>">
      </div>
      <div class="form-group">
        <label for="telefone">Telefone</label>
        <input type="text" id="telefone" name="telefone" class="form-control" value="<%= mecanico.telefone %>">
      </div>
    </div>
    <div class="mt-4"><button type="submit" class="btn">Atualizar</button></div>
  </form>
</div>
