<div class="dashboard-header">
  <div>
    <h1>Mecânicos</h1>
    <p style="color: var(--on-surface-variant); font-size: 0.875rem;">Gerenciamento de registros</p>
  </div>
  <div class="dashboard-actions">
    <a href="/mecanicos/novo" class="btn btn-primary"><i data-feather="plus-circle"></i> Novo Mecânico</a>
  </div>
</div>

<div class="card" style="padding: 0;">
  <div class="table-responsive" style="border: none; box-shadow: none;" style="border-radius: var(--radius-lg); border: 1px solid var(--border-color); box-shadow: var(--shadow-sm);">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Especialidade</th>
          <th>Telefone</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% mecanicos.forEach(m => { %>
          <tr>
            <td><%= m.nome %></td>
            <td><%= m.especialidade || '-' %></td>
            <td><%= m.telefone || '-' %></td>
            <td class="flex gap-2">
              <a href="/mecanicos/<%= m.id %>/editar" class="btn btn-secondary" style="padding: 0.375rem;" title="Editar"><i data-feather="edit"></i></a>
              <form action="/mecanicos/<%= m.id %>?_method=DELETE" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger" style="padding: 0.375rem;" title="Excluir"><i data-feather="trash-2"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (mecanicos.length === 0) { %>
          <tr><td colspan="4" style="text-align: center;">Nenhum mecânico encontrado.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
