<div class="dashboard-header">
  <div>
    <h1>Nova Peça</h1>
    <p style="color: var(--on-surface-variant); font-size: 0.875rem;">Gerenciamento de registros</p>
  </div>
  <div class="dashboard-actions">
    <a href="/pecas" class="btn btn-secondary"><i data-feather="arrow-left"></i> Voltar</a>
  </div>
</div>

<div class="card">
  <form action="/pecas" method="POST">
    <div class="grid grid-cols-2 gap-4">
      <div class="form-group" style="grid-column: span 2;">
        <label for="nome">Nome *</label>
        <input type="text" id="nome" name="nome" class="form-control" required>
      </div>
      <div class="form-group" style="grid-column: span 2;">
        <label for="descricao">Descrição</label>
        <input type="text" id="descricao" name="descricao" class="form-control">
      </div>
      <div class="form-group">
        <label for="valor_unitario">Valor Unitário *</label>
        <input type="number" step="0.01" id="valor_unitario" name="valor_unitario" class="form-control" required>
      </div>
      <div class="form-group">
        <label for="estoque">Estoque Inicial *</label>
        <input type="number" id="estoque" name="estoque" class="form-control" value="0" required>
      </div>
    </div>
    <div class="mt-4"><button type="submit" class="btn btn-primary"><i data-feather="save"></i> Salvar</button></div>
  </form>
</div>
