<div class="dashboard-header">
  <div>
    <h1>Peças</h1>
    <p style="color: var(--on-surface-variant); font-size: 0.875rem;">Gerenciamento de registros</p>
  </div>
  <div class="dashboard-actions">
    <a href="/pecas/novo" class="btn btn-primary">Nova Peça</a>
  </div>
</div>

<div class="card" style="padding: 0;">
  <div class="table-responsive" style="border: none; box-shadow: none;" style="border-radius: var(--radius-lg); border: 1px solid var(--border-color); box-shadow: var(--shadow-sm);">
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Descrição</th>
          <th>Valor Unitário</th>
          <th>Estoque</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% pecas.forEach(p => { %>
          <tr>
            <td><%= p.nome %></td>
            <td><%= p.descricao || '-' %></td>
            <td>R$ <%= parseFloat(p.valor_unitario).toFixed(2) %></td>
            <td><%= p.estoque %></td>
            <td class="flex gap-2">
              <a href="/pecas/<%= p.id %>/editar" class="btn btn-secondary" style="padding: 0.375rem;" title="Editar"><i data-feather="edit"></i></a>
              <form action="/pecas/<%= p.id %>?_method=DELETE" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger" style="padding: 0.375rem;" title="Excluir"><i data-feather="trash-2"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (pecas.length === 0) { %>
          <tr><td colspan="5" style="text-align: center;">Nenhuma peça encontrada.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
