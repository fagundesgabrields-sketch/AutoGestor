<div class="dashboard-header">
  <div>
    <h1>Novo Serviço</h1>
    <p style="color: var(--on-surface-variant); font-size: 0.875rem;">Preencha as informações abaixo</p>
  </div>
  <div class="dashboard-actions">
    <a href="/servicos" class="btn btn-secondary"><i data-feather="arrow-left"></i> Voltar</a>
  </div>
</div>

<div class="card">
  <form action="/servicos" method="POST">
    <div class="grid grid-cols-2 gap-4">
      <div class="form-group" style="grid-column: span 2;">
        <label for="nome">Nome *</label>
        <input type="text" id="nome" name="nome" class="form-control" required>
      </div>
      <div class="form-group" style="grid-column: span 2;">
        <label for="descricao">Descrição</label>
        <input type="text" id="descricao" name="descricao" class="form-control">
      </div>
      <div class="form-group">
        <label for="valor_mao_obra">Valor Mão de Obra *</label>
        <input type="number" step="0.01" id="valor_mao_obra" name="valor_mao_obra" class="form-control" required>
      </div>
    </div>
    <div class="mt-4"><button type="submit" class="btn btn-primary"><i data-feather="save"></i> Salvar</button></div>
  </form>
</div>
